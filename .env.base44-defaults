# Base44 sandbox defaults — PLACEHOLDERS ONLY, never real credentials.
#
# This file is listed FIRST in the `env_file:` list of docker-compose.base44.yml, so the
# values delivered from the platform (/run/base44/app.env, listed LAST) always win.
# It exists so the app can boot before any credentials are configured.
#
# GEMINI_API_KEY: used by the Express server (server.ts) and inlined into the client
# bundle by vite.config.ts, for the AI assistant, AI problem solver, news summary and
# mini-game features. The placeholder keeps the server booting; AI calls fail until a
# real key is supplied.
GEMINI_API_KEY=BASE44_DEV_PLACEHOLDER

# GOOGLE_MAPS_PLATFORM_KEY: optional. Only the marketplace map view uses it; without it
# the marketplace falls back to its list view.
GOOGLE_MAPS_PLATFORM_KEY=BASE44_DEV_PLACEHOLDER
